# Instalación desatendida del LMS Administración y Gestión
# Copia este fichero fuera del repositorio, protégelo con chmod 600
# y rellena únicamente los valores necesarios.

# Obligatorio en producción.
LMS_PUBLIC_BASE_URL=https://lms.ejemplo.es

# Recomendado cuando se usa Cloudflare Tunnel.
# Deja vacío si el túnel se gestiona externamente.
CLOUDFLARE_TUNNEL_TOKEN=

# Destino de instalación.
LMS_INSTALL_DIR=/opt/lms-administracion-y-gestion

# Repositorio y rama/tag.
LMS_INSTALL_REPOSITORY=https://github.com/atreyu1968/LMS-Adminidtracion-y-Gestion.git
LMS_INSTALL_BRANCH=main

# 1 = aprovisiona GTH y NOMINASOL tras arrancar.
# 0 = deja el catálogo sin aprovisionar.
LMS_INSTALL_PROVISION=1
